# ============================
# MkDocs
# ============================
# This is the one that matters. MkDocs builds into site/, not _site/.
site/
.cache/

# Python environment
.venv/
venv/
__pycache__/
*.pyc

# ============================
# Java and build artifacts
# ============================
*.class
*.war
*.ear
*.log

# Compiled output. These patterns have no leading slash, so they match at
# ANY depth. The old */bin/ only matched one level below the repo root, which
# meant examples/sprint-1/bin/ was being committed.
bin/
build/
out/
dist/
target/

# JARs are ignored by default, but a few need to be committable.
*.jar
!gradle/wrapper/gradle-wrapper.jar
!docs/assets/**/*.jar

# ============================
# IDE
# ============================
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
# If you ever want to ship students a shared VS Code Java config, add:
#   !.vscode/settings.json
#   !.vscode/extensions.json

# ============================
# OS
# ============================
.DS_Store
Thumbs.db
desktop.ini

# ============================
# Temporary and backup
# ============================
*.tmp
*.bak
*.swp
*~

# ============================
# Teaching materials not for publication
# ============================
slides/**/*.pptx
exams/**/*.docx
exams/**/*.xlsx

# Note: solution files inside docs/ are handled by exclude_docs in mkdocs.yml,
# not here. They stay in git, they just never reach the built site.